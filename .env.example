# Copy to .env and fill in. These are examples, never real secrets.
# .env is gitignored. Use separate credentials and databases per environment.

# --- Environment and database ---
# Allowed: local, staging, production.
APP_ENV="local"
DATABASE_URL="postgres://gymbuddy:gymbuddy@localhost:5433/gymbuddy"
DB_POOL_MAX="10"

# --- Authentication ---
# Local is an invite-only rollback/development mode. Public production must use
# better-auth. VITE_AUTH_PROVIDER is public and must match AUTH_PROVIDER at build.
AUTH_PROVIDER="local"
VITE_AUTH_PROVIDER="local"
# These may be true for invite-only password recovery while public signups stay
# disabled. Set both values true only after SMTP is configured and verified.
EMAIL_DELIVERY_ENABLED="false"
VITE_EMAIL_DELIVERY_ENABLED="false"
# Generate an independent 32+ byte random secret for every environment.
BETTER_AUTH_SECRET=""
# Extra allowed browser origins, comma-separated. Usually left blank.
AUTH_TRUSTED_ORIGINS=""
# Better Auth rate limiting is automatic in production. This enables it locally.
AUTH_RATE_LIMIT_LOCAL="false"
# Comma-separated Better Auth user UUIDs allowed to use admin operations.
ADMIN_USER_IDS=""

# Generic SMTP. Resend uses smtp.resend.com:465, username "resend", and an API
# key as the password. A verified sender domain is required for real recipients.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_REQUIRE_TLS="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="COACH <no-reply@example.com>"

# Keep both switches equal. False is appropriate for private beta; true enables
# verified self-registration after legal/operator details are complete.
PUBLIC_SIGNUPS_ENABLED="false"
VITE_PUBLIC_SIGNUPS_ENABLED="false"

# --- Optional seeded accounts (npm run db:seed) ---
# Existing emails have their password refreshed. Never commit real values.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-at-least-10-characters"
EXTRA_ADMIN_EMAIL=""
EXTRA_ADMIN_PASSWORD=""

# --- Stripe subscriptions (optional) ---
# Set BILLING_PROVIDER=stripe only after every Stripe setting below is ready.
BILLING_PROVIDER="disabled"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_MONTHLY_PRICE_ID=""
STRIPE_ANNUAL_PRICE_ID=""
# Register the Better Auth webhook:
#   https://your-domain.example/api/auth/stripe/webhook
# Configure EU tax registrations and the customer portal in Stripe first, then
# explicitly acknowledge each production prerequisite.
STRIPE_AUTOMATIC_TAX="false"
STRIPE_EU_TAX_CONFIGURED="false"
STRIPE_CUSTOMER_PORTAL_CONFIGURED="false"

# --- AI backend ---
# openai supports any OpenAI-compatible endpoint; anthropic uses Anthropic.
AI_PROVIDER="openai"
AI_API_KEY="sk-xxx"
# AI_MODEL="gpt-5.5"
# AI_BASE_URL="https://api.openai.com/v1"
# Exact provider rates in USD per million tokens. Public environments require
# input and output rates so the private business dashboard can estimate spend.
AI_COST_INPUT_USD_PER_MILLION=""
AI_COST_OUTPUT_USD_PER_MILLION=""
# Optional; if omitted these use the input rate.
AI_COST_CACHE_READ_USD_PER_MILLION=""
AI_COST_CACHE_WRITE_USD_PER_MILLION=""

# --- Private business analytics ---
# Independent 32+ byte random HMAC secret. Never expose as VITE_*.
ANALYTICS_HASH_SECRET=""
# Comma-separated admin emails permitted to read business analytics. Production
# also requires the user to have the admin role and authenticator-app MFA.
ANALYTICS_ADMIN_EMAILS=""
ANALYTICS_TIMEZONE="Europe/Stockholm"
# Privacy-minimal product events and AI usage ledgers only; payment accounting
# records follow the separate legally required financial retention period.
ANALYTICS_RETENTION_DAYS="760"

# --- Public reverse proxy and legal identity ---
PUBLIC_ORIGIN="http://localhost:8080"
# Enable only behind a trusted proxy that overwrites X-Real-IP.
TRUST_PROXY_HEADERS="false"
LEGAL_OPERATOR_NAME=""
LEGAL_CONTACT_EMAIL=""
LEGAL_OPERATOR_COUNTRY="Sweden"
