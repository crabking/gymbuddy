# Copy to .env and fill in. Values here are examples, not real secrets.
# NOTE: .env is gitignored — never commit real secrets (this repo is public).

# --- Database ---
# Local dev (matches docker-compose.yml): docker compose up -d
DATABASE_URL="postgres://gymbuddy:gymbuddy@localhost:5433/gymbuddy"

# --- Login seeding (npm run db:seed) ---
# The app is invite-only: the ONLY way in is an account seeded here. There is no
# public sign-up. Re-run `npm run db:seed` with different values to add more
# people (existing emails get their password updated).
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

# --- AI backend ---
# Pick a provider and plug in your own key.
#   AI_PROVIDER=openai     -> any OpenAI-compatible endpoint (default)
#   AI_PROVIDER=anthropic  -> Anthropic
AI_PROVIDER="openai"
AI_API_KEY="sk-xxx"
# AI_MODEL="gpt-5.5"                        # e.g. gpt-5.5 (openai) or claude-sonnet-5 (anthropic)
# AI_BASE_URL="https://api.openai.com/v1"   # openai only: OpenAI, OpenRouter, Groq, self-hosted…
